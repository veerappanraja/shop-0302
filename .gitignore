# =============================================================================
# Java / Spring Boot / Maven .gitignore
# =============================================================================

# ----- Java / Maven build output -----
target/
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*

# ----- Maven wrapper -----
.mvn/wrapper/maven-wrapper.jar

# ----- H2 Database files -----
*.db
*.db.mv.db
*.db.trace.db
ecommerce.mv.db
ecommerce.trace.db

# ----- IDE / Editor -----
.idea/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/
.factorypath
.springBeans
*.swp
*.swo
*~
.vscode/

# ----- OS -----
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ----- Environment / secrets (should never be committed) -----
.env
.env.*
!.env.example
!.env.template

# ----- Logs -----
*.log

# ----- Test / coverage -----
coverage/
*.lcov
